{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Landespolizeidirektion Vorarlberg",
  "version": "0.1.0",
  "identifier": "at.lpd-vorarlberg.app",
  "app": {
    "windows": [
      {
        "title": "Landespolizeidirektion Vorarlberg",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null,
      "dangerousDisableAssetCspModification": true
    },
    "withGlobalTauri": true
  },
  "build": {
    "frontendDist": "./dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Hankemacht – Miriam Hanke",
    "homepage": "https://hankemacht.de",
    "copyright": "© 2026 Hankemacht – Miriam Hanke",
    "shortDescription": "Whiteboard für die Landespolizeidirektion Vorarlberg",
    "longDescription": "Whiteboard-Anwendung für die Landespolizeidirektion Vorarlberg. Entwickelt von Miriam Hanke / Hankemacht.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}